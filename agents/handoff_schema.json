{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NFL Edge Lab agent handoff",
  "type": "object",
  "required": [
    "task_id", "agent", "agent_version", "objective", "data_cutoff", "method",
    "results", "limitations", "reproducibility", "recommendation", "artifacts",
    "audit_status", "next_action", "created_at"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Z0-9]+-[A-Z]+-[0-9]{3}$", "description": "e.g. P1-DATA-002" },
    "agent": { "type": "string", "enum": ["orchestrator", "data-engineer", "nfl-research", "market-research", "modeling", "backtesting", "auditor"] },
    "agent_version": { "type": "string", "pattern": "^a[0-9]+\\.[0-9]+$" },
    "objective": { "type": "string" },
    "hypothesis": { "type": ["string", "null"] },
    "input_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "snapshot_id": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] }
        }
      }
    },
    "data_cutoff": { "type": "string", "description": "ISO-8601 UTC or 'n/a'" },
    "method": { "type": "string" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "results": { "type": "object" },
    "uncertainty": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "unverified": { "type": "array", "items": { "type": "string" } },
    "reproducibility": {
      "type": "object",
      "required": ["commit"],
      "properties": {
        "commit": { "type": "string" },
        "commands": { "type": "array", "items": { "type": "string" } },
        "python": { "type": ["string", "null"] },
        "packages": { "type": ["object", "null"] },
        "seed": { "type": ["integer", "null"] },
        "config_hash": { "type": ["string", "null"] }
      }
    },
    "recommendation": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "disagreements": { "type": "array", "items": { "type": "string" } },
    "audit_status": { "type": "string", "enum": ["NOT_AUDITED", "APPROVED", "APPROVED_WITH_CONDITIONS", "REVISION_REQUIRED", "REJECTED"] },
    "next_action": { "type": "string" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": false
}
